# Roppets Edutainment Production Inc. - Environment Configuration Example
# Copy this file to .env and configure your local or cloud database credentials.

# Database Driver: 'pgsql' (PostgreSQL / Neon) or 'mysql' (MySQL / MariaDB / XAMPP)
DB_DRIVER=pgsql

# PostgreSQL Configuration
DB_HOST=ep-wild-wind-ayk3w0b8.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=your_db_password_here
DB_SSLMODE=require

# MySQL Backup Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=roppet_db
MYSQL_USER=root
MYSQL_PASS=

# AI Model
GEMINI_MODEL=gemini-1.5-flash
SMTP_FROM=edutainment@roppets.com
