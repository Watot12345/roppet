# Roppets Edutainment Production Inc. - Environment Configuration Example
# Copy this file to .env and configure your local or cloud database credentials.

# Database Driver: 'pgsql' (Supabase PostgreSQL) or 'mysql' (MySQL / MariaDB / XAMPP)
DB_DRIVER=pgsql

# Supabase PostgreSQL Configuration
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.olrpqobxouiyymvujxkw
DB_PASS=your_supabase_password_here
DB_SSLMODE=require

# Supabase REST / Auth API
SUPABASE_REF=olrpqobxouiyymvujxkw
SUPABASE_URL=https://olrpqobxouiyymvujxkw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# MySQL Backup Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=roppet_db
MYSQL_USER=root
MYSQL_PASS=

# AI Model
GEMINI_MODEL=gemini-1.5-flash
SMTP_FROM=edutainment@roppets.com
